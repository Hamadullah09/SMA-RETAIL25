             FError(nErr) 
             THROW IOException{i"Error moving file pointer from {origin} to {offset}"}
             
+        // Local patch (Retail Plus spike): .NET 6+ no longer routes the Position setter through the virtual Seek(),
+        // so ReadFile/WriteFile above would use a stale OS file pointer. Keep Position on the same OS pointer.
+        PUBLIC OVERRIDE PROPERTY Position AS INT64
+            GET
+                RETURN SELF:Seek(0, SeekOrigin.Current)
+            END GET
+            SET
+                SELF:Seek(VALUE, SeekOrigin.Begin)
+            END SET
+        END PROPERTY
+
