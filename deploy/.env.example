# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

POSTGRES_DB=retail25
POSTGRES_USER=retail25
POSTGRES_PASSWORD=change-me-strong
POSTGRES_PORT=5432

REDIS_PASSWORD=change-me-strong
REDIS_PORT=6379

# Public origin the browser and terminal agents use. Must be https in production.
PUBLIC_URL=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Next.js BFF session encryption key (32+ random bytes, base64).
SESSION_SECRET=change-me-base64-32-bytes-minimum

ASPNETCORE_ENVIRONMENT=Production

# Migrations are applied as an explicit deployment step in production.
DB_AUTO_MIGRATE=false

# Seed = reference data and configuration defaults required for the system to run
# (permissions, tender types, product-type behaviours, pricing rule order, keybindings).
SEED_ENABLED=true

# Demo data = the sample hiking/camping store from the legacy TST location. Off by default.
SEED_DEMO_DATA=false
