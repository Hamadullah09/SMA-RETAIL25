<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Next.js front end at the site root (pos.sma-techno.net).

  HttpPlatformHandler rather than iisnode. iisnode hands the child process a named pipe in PORT,
  and Next's standalone server does `parseInt(process.env.PORT)` — the pipe parses to NaN, Next
  falls back to TCP 3000, and IIS waits on a pipe nobody is listening to. HttpPlatformHandler
  assigns a real port, which is what Next expects.

  Deployed to the site root alongside server.js from the standalone build.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <clear />
        <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
      </handlers>

      <httpPlatform processPath="node"
                    arguments=".\server.js"
                    stdoutLogEnabled="true"
                    stdoutLogFile=".\logs\node.log"
                    startupTimeLimit="120"
                    startupRetryCount="3"
                    requestTimeout="00:04:00">
        <environmentVariables>
          <!-- HttpPlatformHandler picks the port and reverse-proxies to it. -->
          <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
          <environmentVariable name="HOSTNAME" value="127.0.0.1" />
          <environmentVariable name="NODE_ENV" value="production" />
          <environmentVariable name="NEXT_TELEMETRY_DISABLED" value="1" />

          <!-- The BFF's back channel to the API. Server-side only; the browser never sees it. -->
          <environmentVariable name="API_URL" value="https://pos.sma-techno.net/backend" />

          <!-- Public origin exactly as the browser sees it, no trailing slash. -->
          <environmentVariable name="APP_ORIGIN" value="https://pos.sma-techno.net" />
          <environmentVariable name="OIDC_CLIENT_ID" value="retail25-web" />

          <!--
            The origin the browser opens SignalR connections against. Present here for symmetry
            only — Next inlines NEXT_PUBLIC_* at build time, so the value that actually reaches
            the browser is the one the workflow passed to `npm run build`. Changing it here
            changes nothing.
          -->
          <environmentVariable name="NEXT_PUBLIC_API_URL" value="https://pos.sma-techno.net/backend" />

          <!--
            SESSION_SECRET is deliberately absent. It comes from the application pool's environment
            variables, which the node process inherits; declaring it here with value="" would set
            it to the empty string rather than inherit, and the app refuses to hold a session
            without one. Everything above is non-secret and safe to pin.
          -->
        </environmentVariables>
      </httpPlatform>

      <!-- SignalR negotiates from pages served here; the proxy has to pass the upgrade through. -->
      <webSocket enabled="true" pingInterval="00:00:10" />

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
