<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Release only, and unchecked by the analyzers that police the production projects. A benchmark
      measures a Debug build as roughly nothing useful, and BenchmarkDotNet refuses to run one.
    -->
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Retail25.Application\Retail25.Application.csproj" />
    <ProjectReference Include="..\..\src\Retail25.Contracts\Retail25.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Retail25.TerminalAgent\Retail25.TerminalAgent.csproj" />
  </ItemGroup>

</Project>
