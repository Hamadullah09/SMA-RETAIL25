<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <Product>Retail25</Product>
    <Company>Retail25</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    CA1848 (LoggerMessage delegates) and CA2007 (ConfigureAwait) are deliberately relaxed:
    this is an ASP.NET Core application with no synchronization context, and structured logging
    is applied where it measurably matters (hot paths) rather than universally.

    CA1711 forbids the reserved suffix "Permission". Here it is the correct domain word — a
    `Permission` row and a `RolePermission` grant are exactly what the security model calls them,
    and renaming them to satisfy a naming rule would make the code disagree with doc 07.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1062;CA1812;CA1859;CA1716;CA1720;CA1873;CA1852;CA1725;CA2016;CA1862;CA1711</NoWarn>
  </PropertyGroup>

</Project>
