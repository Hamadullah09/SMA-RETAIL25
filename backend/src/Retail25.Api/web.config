<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the API when it runs as a sub-application of the front end's site
  (pos.sma-techno.net/backend). `dotnet publish` rewrites processPath and arguments; everything
  else here is ours.

  The whole file sits inside <location inheritInChildApplications="false"> because the parent site
  is a Node application. Without it IIS merges the parent's httpPlatform handler into this app's
  handler list and every API request is answered by the Next.js process instead.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Drop anything inherited from the parent site before claiming the path. -->
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        outofprocess, for two reasons specific to this host.

        The account's application pool is 32-bit and shared by every site on it. An in-process app
        runs inside w3wp and so inherits its bitness, which would mean needing the x86 runtime;
        out-of-process starts its own dotnet.exe and does not care. The control panel also warns
        that hosting more than one ASP.NET Core app on the account requires out-of-process, and
        this app is not the only thing that will ever run here.

        The cost is one loopback hop per request. HTTPS still reports correctly: the module sends
        X-Forwarded-Proto and the IIS integration middleware, which is registered automatically
        when the module launches the process, applies it — without that UseHttpsRedirection would
        see plain HTTP and redirect forever.

        stdout logging is off. It earned its place during the first deploy — the certificate
        failure that took two attempts to pin down was legible only here — but the file grows
        without bound and nothing rotates it. Turn it back on to diagnose a process that will not
        start, and turn it off again afterwards.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Retail25.Api.dll"
                  hostingModel="outofprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout">
        <!--
          Non-secret only, and nothing declared that it does not intend to set.

          The connection strings, the certificate password and the seed administrator come from the
          application pool's environment variables, set once in the control panel. They are not
          listed here even as blanks: an element with value="" does not mean "inherit", it means
          "set this to the empty string", and it would override the pool value with nothing. The
          application would then start against no database and report a configuration error that
          this file appears not to contain.
        -->
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!--
            The public origin, which appsettings.Production.json ships as a placeholder because it
            differs per deployment. Left unset it reached production as `https://your-site.example`
            and was observably live: the content-security-policy header served by this API named it
            in form-action. Nothing had failed loudly, because 'self' already covers the real origin
            and every browser call is same-origin — but a password-reset link would have pointed at
            a domain nobody owns.

            Non-secret and deployment-specific, which is exactly what belongs in this file.
          -->
          <environmentVariable name="Auth__WebOrigin" value="https://pos.sma-techno.net" />
          <environmentVariable name="AllowedOrigins__0" value="https://pos.sma-techno.net" />
        </environmentVariables>
      </aspNetCore>

      <!--
        SignalR carries the cart, the terminal feed and the reader feed. Without WebSockets it
        falls back to server-sent events and long polling, which work but add a round trip to
        every till update. If IIS answers 500.19 on this element the shared plan has the section
        locked — remove it and the hubs still run on the fallback transports.
      -->
      <webSocket enabled="true" pingInterval="00:00:10" />

      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Tag imports post large files; the default 30 MB ceiling rejects a real export. -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
