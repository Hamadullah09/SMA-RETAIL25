<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      The terminal agent's client secret is set here rather than in appsettings.Development.json,
      which is committed and documented as holding no credentials.

        dotnet user-secrets set "Auth:AgentClientSecret" "VALUE" (project src/Retail25.Api)
    -->
    <UserSecretsId>retail25-api</UserSecretsId>

    <!--
      Workstation garbage collection, which is not the ASP.NET Core default.

      Server GC allocates a heap and a collection thread per logical core. On a shared host that
      means sizing against the machine's core count rather than this application's share of it, and
      the pool it runs in is capped at 1 GB — the process is killed for exceeding a quota it never
      needed the memory for. myASP.NET's own guidance says the same thing, as a runtimeconfig.json
      edit after the fact; setting it here means the published runtimeconfig.json is already right
      and a redeploy cannot silently undo it.

      Revisit if this ever runs somewhere with memory to spare: server GC has materially better
      throughput under load, which a busy shop would want.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Retail25.Infrastructure\Retail25.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- MigrateAsync lives in the relational assembly; the startup path applies migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
