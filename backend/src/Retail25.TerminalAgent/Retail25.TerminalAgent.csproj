<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <UserSecretsId>retail25-terminal-agent</UserSecretsId>
    <OutputType>Exe</OutputType>
    <!-- Installed as a Windows service; the same binary runs as a console app for bench testing. -->
    <AssemblyName>Retail25.TerminalAgent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Retail25.Contracts\Retail25.Contracts.csproj" />
    <ProjectReference Include="..\Retail25.Devices\Retail25.Devices.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The loopback API on 127.0.0.1:8477 needs the ASP.NET Core hosting stack (doc 06 §5). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!--
      Microsoft.Extensions.Hosting(.Abstractions), .Http and .Options.ConfigurationExtensions are
      not listed: the FrameworkReference above carries them on net10.0, and naming them as packages
      too is an NU1510 error.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Retail25.TerminalAgent.UnitTests" />

    <!-- The throughput benchmark drives the codec and the tag buffer directly; both are internal. -->
    <InternalsVisibleTo Include="Retail25.Benchmarks" />
  </ItemGroup>
</Project>
