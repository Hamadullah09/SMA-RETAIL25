<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
    <!--
      Microsoft.Extensions.* track the runtime: on net10.0 the shared framework carries 10.0.x, and
      a lower central version becomes an NU1109 downgrade error the moment anything pulls the
      framework's own copy transitively. Keep these level with the TargetFramework in
      Directory.Build.props — the two move together or not at all.

      Every Microsoft 10.0.x package here went from 10.0.10 to 10.0.13 at once, because advisories
      published after 10.0.10 shipped (GHSA-334f-vvp4-7g6p against SignalR.Common, and three against
      Cryptography.Xml) turned restore red under TreatWarningsAsErrors. Pinning only the vulnerable
      assembly was tried first and does not work: its 10.0.13 pulls Microsoft.Extensions 10.0.13,
      which collides with every pin left at 10.0.10. Servicing releases are cut together to be taken
      together.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Identity and auth">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <!--
      OpenIddict 7 rather than 5: its EF Core integration binds to the EF Core major it was built
      against, so it has to move when EF Core does. 5.x is built against EF Core 8.
    -->
    <!--
      Shopper tokens only. Staff sign in through OpenIddict and always will; the phone app is a
      separate audience with a separate signing key and no permission claims at all, and giving it
      its own scheme is what keeps "a customer's token can never satisfy a till" a property of the
      wiring rather than of a check somebody has to remember.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Caching and realtime">
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Jobs, documents, data">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.24" />
    <PackageVersion Include="QuestPDF" Version="2024.10.3" />
    <PackageVersion Include="ZXing.Net" Version="0.16.9" />
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.HealthChecks" Version="2.2.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="CsCheck" Version="4.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <!--
    Transitive pins that exist only to clear security advisories. Nothing references these directly;
    they arrive under Hangfire, SignalR, EF Core and OpenTelemetry, and The scan that found them is
    `dotnet list package` with the vulnerable and include-transitive switches. (Spelled out in
    words because an XML comment may not contain a double hyphen, which is how this file broke once
    already.)

    Each is pinned to the lowest patched version inside its existing major, deliberately. Taking the
    newest available would mean Newtonsoft 13, SQLitePCLRaw 3 and MessagePack 3 — two major bumps
    across a serial-port spool and a hub protocol, for no security benefit over these.

    Re-run the scan after touching any of the packages above; a pin that is no longer needed is a
    version this project is silently holding back for nobody.
  -->
  <ItemGroup Label="Security pins (transitive)">
    <!--
      GHSA-5crp-9r3c-p9vr — DoS from deeply nested JSON. Pulled in by Hangfire. 13.0.3 cleared the
      advisory; 13.0.4 is here because EF Core Design 10.0.13 asks for at least that, and a central
      pin below a dependency's floor is a restore error (NU1109), not a quiet downgrade.
    -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!--
      GHSA-2m69-gcr7-jv3q — under Microsoft.Data.Sqlite, the agent's offline tag spool. 2.1.12
      cleared the advisory; 2.1.13 is the floor Microsoft.Data.Sqlite 10.0.13 sets, for the same
      reason as Newtonsoft above.
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />

    <!--
      GHSA-4qm4-8hg2-g2xm — SignalR's MessagePack hub protocol. Then GHSA-qhrr-8q5h-9q3h, nested
      arrays blowing past buffer limits, fixed in 2.5.303: still the lowest patched release inside
      the 2.x major, for the same reason as before.
    -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />

    <!--
      GHSA-846f-f764-76mx (CVE-2026-84008, high) and GHSA-2fmv-rv2c-59x7 (moderate) — .NET
      denial of service in PKCS handling, every 9.0.x up to 9.0.20 and 10.0.x up to 10.0.12. The
      API and Infrastructure were resolving 9.0.4 and the migration tool 10.0.10. One pin lands all
      three on 10.0.13, the version that matches the runtime they all run on; leaving them split
      would mean patching two lines and watching two.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>


