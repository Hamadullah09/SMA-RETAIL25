{
  "name": "sma-retail-web",
  "version": "0.1.0",
  "private": true,
  "description": "SMA RETAIL web back office: a static Next.js app served by RetailPlus.Server.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node e2e/serve.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
