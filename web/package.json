    "e2e": "playwright test --project=desktop --project=phone",
    "screens": "playwright test --project=screens"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
