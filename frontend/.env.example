# Copy to .env.local on each machine.

# --- BFF (server-side only; none of these reach the browser) ---------------------------------

# Where the API lives. The BFF talks to it over a back channel; the browser never does.
API_URL=http://localhost:5000

# This app's own public origin. Must match the redirect URI registered for the web client.
APP_ORIGIN=http://localhost:3000

OIDC_CLIENT_ID=retail25-web

# Encrypts the session cookie. At least 32 characters, and different per environment — a shared
# secret would make a session cookie forged against one deployment valid on every other. There is
# deliberately no default: the app refuses to hold a session without it.
SESSION_SECRET=

# --- Public (compiled into the browser bundle; never put a secret here) -----------------------

# The hub origin. Only used for the SignalR URL; the connection authenticates with a single-use
# ticket minted by the BFF, not with an access token.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Which physical till this machine is. These identify hardware, not a user, so they belong in the
# machine's environment rather than in a picker a cashier could get wrong mid-queue. Take the values
# from the station and location rows the seeder created on first run.
NEXT_PUBLIC_STATION_ID=
NEXT_PUBLIC_LOCATION_ID=

# --- End-to-end tests -------------------------------------------------------------------------

E2E_USERNAME=admin@retail25.local
E2E_PASSWORD=
