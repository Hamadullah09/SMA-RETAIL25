<Window x:Class="RetailPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retail Plus" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: brand pill, store name, clock, user. -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock x:Name="ClockText" FontFamily="{StaticResource DisplayFont}" FontSize="26" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateText" Foreground="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Right" />
                </StackPanel>
                <Border x:Name="TrainingBadge" Background="{StaticResource DangerLight}" CornerRadius="22" Padding="16,8" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Training mode" Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
                </Border>
                <Button Style="{StaticResource RoundButton}" Content="&#xE897;" ToolTip="Help: keyboard keys" Margin="0,0,10,0" Click="Help_Click" />
                <Button Style="{StaticResource RoundButton}" Content="&#xE713;" ToolTip="Setup" Margin="0,0,10,0" Click="Settings_Click" x:Name="SettingsButton" />
                <Border Background="{StaticResource CardSolid}" CornerRadius="28" Padding="6,6,18,6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Sun}">
                            <TextBlock x:Name="Initials" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserText" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock x:Name="LevelText" Foreground="{StaticResource Muted}" FontSize="13" />
                        </StackPanel>
                        <Button Content="Switch user" Style="{StaticResource DarkButton}" Margin="0" MinHeight="40" Padding="16,0" FontSize="15" Click="SwitchUser_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border BorderBrush="{StaticResource Charcoal}" BorderThickness="1.5" CornerRadius="30" Padding="24,8">
                    <TextBlock Text="Retail Plus" FontFamily="{StaticResource DisplayFont}" FontSize="26" />
                </Border>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StoreName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <TextBlock x:Name="StationText" Foreground="{StaticResource Muted}" FontSize="15" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: one big pill per screen. -->
            <Border Style="{StaticResource CardBorder}" Padding="12,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="ShortcutHint" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="10,8,10,0"
                               Text="Tip: Ctrl + 1 … 9 opens a screen" />
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="21" Width="34" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="20,0,0,0" Focusable="False" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="4,10,4,0">
            <TextBlock x:Name="DatabaseText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="14" />
            <TextBlock x:Name="StatusText" FontSize="15" />
        </DockPanel>
    </Grid>
</Window>
