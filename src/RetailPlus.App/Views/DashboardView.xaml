<UserControl x:Class="RetailPlus.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:RetailPlus.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="0,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Greeting and the three big numbers. -->
            <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center">
                <TextBlock x:Name="Greeting" FontFamily="{StaticResource DisplayFont}" FontSize="44" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" FontSize="18" Margin="2,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Margin="0,0,34,0">
                    <TextBlock x:Name="StatSales" Style="{StaticResource BigNumber}" FontSize="50" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardSolid}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" FontSize="15" />
                        </Border>
                        <TextBlock Text="Sales today" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,34,0">
                    <TextBlock x:Name="StatCustomers" Style="{StaticResource BigNumber}" FontSize="50" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardSolid}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="15" />
                        </Border>
                        <TextBlock Text="Customers today" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="StatItems" Style="{StaticResource BigNumber}" FontSize="50" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardSolid}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="15" />
                        </Border>
                        <TextBlock Text="Items for sale" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- How customers paid: pills sized by share. -->
            <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,16,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="PaymentsBar" />
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Bottom">
                    <TextBlock x:Name="PaymentsCaption" Foreground="{StaticResource Muted}" Margin="4,0,0,6" />
                    <Border BorderBrush="{StaticResource Stone}" BorderThickness="1.5" CornerRadius="24" MinHeight="48" Padding="20,0">
                        <TextBlock x:Name="AverageSale" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Quick start card. -->
            <Border Grid.Row="2" Style="{StaticResource DarkCard}" Margin="0,0,16,16" MinHeight="318">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Sun}">
                            <TextBlock x:Name="BigInitials" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CardUser" FontFamily="{StaticResource DisplayFont}" FontSize="22" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CardLevel" Foreground="#B9B5AC" FontSize="15" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="Start a new sale" infra:Look.Icon="&#xE7BF;" Style="{StaticResource AccentButton}" Margin="0,0,0,10" MinHeight="60" FontSize="19" Click="NewSale_Click" />
                        <UniformGrid Columns="2">
                            <Button Content="Find item" infra:Look.Icon="&#xE721;" Margin="0,0,5,0" Click="FindItem_Click" />
                            <Button Content="New client" infra:Look.Icon="&#xE8FA;" Margin="5,0,0,0" Click="NewClient_Click" />
                        </UniformGrid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- This week. -->
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,16,16" MinHeight="318">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Content="&#xE8AD;" ToolTip="Open the reports" Click="Reports_Click" Width="46" Height="46" />
                        <TextBlock Text="Sales this week" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="WeekTotal" FontFamily="{StaticResource DisplayFont}" FontSize="34" />
                        <TextBlock Text="  last 7 days" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                    <ItemsControl x:Name="WeekBars" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,6,0,0" />
                                    <Ellipse DockPanel.Dock="Bottom" Width="9" Height="9" Fill="{Binding BarBrush}" Margin="0,6,0,0" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="{StaticResource Sun}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" Margin="0,0,0,6"
                                                Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ValueText}" FontSize="13" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Width="12" Height="{Binding BarHeight}" CornerRadius="6" Background="{Binding BarBrush}" HorizontalAlignment="Center"
                                                ToolTip="{Binding ToolTip}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Cash drawer dial. -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,16,16" MinHeight="318">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundButton}" Content="&#xE8AD;" ToolTip="Open the Point of Sale" Click="NewSale_Click" Width="46" Height="46" />
                        <TextBlock Text="Cash drawer" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="DrawerCaption" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="15" />
                    <Grid Margin="0,8,0,8">
                        <infra:RingGauge x:Name="DrawerRing" RingBrush="{StaticResource Sun}" TickBrush="{StaticResource Charcoal}" Width="190" Height="190" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="DrawerCash" FontFamily="{StaticResource DisplayFont}" FontSize="30" HorizontalAlignment="Center" />
                            <TextBlock Text="cash in drawer" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Stock health and the items to reorder (tall, like the onboarding card). -->
            <Border Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,18,22,14">
                        <DockPanel>
                            <TextBlock x:Name="StockPercent" DockPanel.Dock="Right" FontFamily="{StaticResource DisplayFont}" FontSize="38" />
                            <TextBlock Text="Stock health" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid x:Name="StockBar" Margin="0,12,0,0" Height="74" />
                    </StackPanel>
                    <Border Style="{StaticResource DarkCard}" Margin="10,0,10,10" Padding="18,16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock x:Name="ReorderCount" DockPanel.Dock="Right" FontFamily="{StaticResource DisplayFont}" FontSize="32" />
                                <TextBlock Text="Items to reorder" FontFamily="{StaticResource DisplayFont}" FontSize="20" VerticalAlignment="Center" />
                            </DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Make a purchase order" infra:Look.Icon="&#xE719;" Style="{StaticResource AccentButton}" Margin="0,10,0,0" Click="Reorder_Click" />
                            <TextBlock x:Name="NoReorder" DockPanel.Dock="Top" Foreground="#B9B5AC" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Nothing needs reordering. Items show up here when they run low." />
                            <ItemsControl x:Name="ReorderList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,5">
                                            <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="21" Background="#3D3D3D" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="White" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="13" Background="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="#A9A59C" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- At a glance: things waiting for attention. -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,16,16" Padding="14,12">
                <StackPanel x:Name="Glance" />
            </Border>

            <!-- Recent sales. -->
            <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,16,16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Sales journal" infra:Look.Icon="&#xE8A5;" Margin="0" MinHeight="40" FontSize="15" Click="Journal_Click" />
                        <TextBlock Text="Recent sales" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="NoSales" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="No sales yet. Press &#x201C;Start a new sale&#x201D; to ring up the first one." />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="15" />
                                    <Border Grid.Column="1" Background="{Binding PillBrush}" CornerRadius="16" Padding="16,9">
                                        <DockPanel TextElement.Foreground="{Binding TextBrush}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                                                <TextBlock Text="{Binding Detail}" FontSize="13" Opacity="0.75" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
