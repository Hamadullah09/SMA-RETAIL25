<UserControl x:Class="RetailPlus.App.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:RetailPlus.App.Infrastructure">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Scan / type box. -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Find item" infra:Look.Icon="&#xE721;" Style="{StaticResource AccentButton}" Margin="10,0,0,0" MinHeight="62" FontSize="19"
                        ToolTip="Search the inventory by name (F3)" Click="Find_Click" />
                <Button DockPanel.Dock="Right" Content="Item without code" infra:Look.Icon="&#xE710;" Margin="10,0,0,0" MinHeight="62"
                        ToolTip="Sell something that is not in the inventory" Click="OpenItem_Click" />
                <Grid>
                    <TextBox x:Name="CodeBox" FontSize="22" MinHeight="62" Padding="50,10,12,10" Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}" KeyDown="CodeBox_KeyDown" />
                    <TextBlock Text="&#xE8EC;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="18,0,0,0" FontSize="20" Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
                    <TextBlock Text="Scan a barcode or type an item code, then press Enter" Margin="52,0,12,0" VerticalAlignment="Center" FontSize="19"
                               Foreground="{StaticResource Muted}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CodeBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <!-- Client. -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,14,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Use points" infra:Look.Icon="&#xE734;" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Reward_Click"
                                Visibility="{Binding CanReward, Converter={StaticResource BoolToVis}}" />
                        <Button Margin="8,0,0,0" Click="Rfid_Click" ToolTip="Pause or resume RFID reading at this counter"
                                Visibility="{Binding RfidVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="{Binding RfidBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RfidText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Choose client" infra:Look.Icon="&#xE716;" Style="{StaticResource DarkButton}" Margin="8,0,0,0" ToolTip="F4" Click="Client_Click" />
                        <Button Content="Remove" infra:Look.Icon="&#xE711;" Margin="8,0,0,0" Click="ClearClient_Click"
                                Visibility="{Binding HasClient, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource SunLight}" Margin="0,0,14,0">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClientText}" FontWeight="SemiBold" FontSize="19" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ClientDetail}" Foreground="{StaticResource Muted}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The lines of the sale. -->
            <DataGrid x:Name="LinesGrid" Grid.Row="2" Style="{StaticResource Grid}" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      SelectionMode="Single" FontSize="19">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="MinHeight" Value="54" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Code" Binding="{Binding Plu}" Width="120" />
                    <DataGridTextColumn Header="Option" Binding="{Binding VariantText}" Width="90" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=0.###}" Width="70" ElementStyle="{StaticResource Right}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Right}" />
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Right}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Right}" FontWeight="Bold" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Fast keys. -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding FastKeys}" Margin="-4,10,-4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PosButton}" Click="FastKey_Click" Tag="{Binding}" MinHeight="64" Background="{StaticResource SunLight}"
                                BorderBrush="{StaticResource Sun}" ToolTip="{Binding Name}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Messages for the cashier. -->
            <Border Grid.Row="4" Margin="0,10,0,0" Padding="16,12" CornerRadius="20" Background="{StaticResource SunLight}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ModeText}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" Margin="12,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Message}" FontSize="18" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Totals. -->
            <Border Style="{StaticResource DarkCard}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subtotal" Foreground="#B9B5AC" />
                    <TextBlock Grid.Column="1" Text="{Binding SubtotalText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="Discount" Foreground="#B9B5AC" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountText}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="2" Text="{Binding Tax1Label}" Foreground="#B9B5AC" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tax1Text}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="3" Text="{Binding Tax2Label}" Foreground="#B9B5AC" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Tax2Text}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" Background="#4A4A4A" Margin="0,12,0,8" />
                    <TextBlock Grid.Row="5" Text="Total to pay" FontSize="19" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalText}" FontFamily="{StaticResource DisplayFont}" FontSize="52" Foreground="{StaticResource Sun}" />
                </Grid>
            </Border>

            <Button Grid.Row="1" Content="PAY" infra:Look.Icon="&#xE8C7;" Style="{StaticResource AccentButton}" FontSize="28" MinHeight="86" Margin="0,12,0,8"
                    infra:Look.CornerRadius="30" ToolTip="Take the payment (F12)" Click="Pay_Click" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <UniformGrid Columns="3" Margin="-4,0,-4,0">
                    <Button Content="Change quantity" infra:Look.Icon="&#xE8EF;" Style="{StaticResource PosButton}" ToolTip="F5" Click="Qty_Click" />
                    <Button Content="Change price" infra:Look.Icon="&#xE8EC;" Style="{StaticResource PosButton}" ToolTip="F6" Click="Price_Click" />
                    <Button Content="Remove line" infra:Look.Icon="&#xE74D;" Style="{StaticResource PosButton}" ToolTip="Delete key" Click="Remove_Click" />
                    <Button Content="Discount on line" infra:Look.Icon="&#xE734;" Style="{StaticResource PosButton}" Click="LineDiscount_Click" />
                    <Button Content="Discount on sale" infra:Look.Icon="&#xE735;" Style="{StaticResource PosButton}" Click="SubtotalDiscount_Click" />
                    <ToggleButton Content="Return / refund" infra:Look.Icon="&#xE7A7;" Style="{StaticResource PosToggle}" IsChecked="{Binding ReturnMode}"
                                  ToolTip="The next item is taken back" />
                    <Button Content="Put on hold" infra:Look.Icon="&#xE769;" Style="{StaticResource PosButton}" Click="Suspend_Click" />
                    <Button Content="Bring back" infra:Look.Icon="&#xE768;" Style="{StaticResource PosButton}" ToolTip="Recall a sale put on hold" Click="Recall_Click" />
                    <Button Content="Save as quote" infra:Look.Icon="&#xE8A5;" Style="{StaticResource PosButton}" Click="Quote_Click" />
                    <Button Content="Layaway" infra:Look.Icon="&#xE787;" Style="{StaticResource PosButton}" Click="Layaway_Click" />
                    <Button Content="Print last receipt" infra:Look.Icon="&#xE749;" Style="{StaticResource PosButton}" Click="Reprint_Click" />
                    <Button Content="Open drawer" infra:Look.Icon="&#xE8B7;" Style="{StaticResource PosButton}" ToolTip="No sale" Click="NoSale_Click" />
                    <Button Content="Money in" infra:Look.Icon="&#xE710;" Style="{StaticResource PosButton}" Background="{StaticResource Cream}" ToolTip="Pay in" Click="PayIn_Click" />
                    <Button Content="Money out" infra:Look.Icon="&#xE738;" Style="{StaticResource PosButton}" Background="{StaticResource Cream}" ToolTip="Pay out" Click="PayOut_Click" />
                    <Button Content="Starting cash" infra:Look.Icon="&#xE8C7;" Style="{StaticResource PosButton}" Background="{StaticResource Cream}" ToolTip="Opening float" Click="Float_Click" />
                    <Button Content="Drawer report" infra:Look.Icon="&#xE9D2;" Style="{StaticResource PosButton}" Background="{StaticResource Cream}" ToolTip="X report" Click="XReport_Click" />
                    <Button Content="End of day" infra:Look.Icon="&#xE708;" Style="{StaticResource PosButton}" Background="{StaticResource Cream}" ToolTip="Z report: close the drawer" Click="EndOfDay_Click" />
                    <Button Content="Cancel sale" infra:Look.Icon="&#xE711;" Style="{StaticResource PosButton}" Background="{StaticResource DangerLight}" Foreground="{StaticResource Danger}"
                            BorderBrush="#F2C4BB" Click="Clear_Click" />
                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
