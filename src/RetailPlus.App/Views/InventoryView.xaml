<UserControl x:Class="RetailPlus.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:RetailPlus.App.Infrastructure">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="Inventory" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <TextBlock Text="Search  (Ctrl+F)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SearchBox" Width="340" Margin="0,0,12,6" TextChanged="Search_TextChanged" ToolTip="Search by stock code, name, barcode, supplier code, brand or RFID tag code (EPC)" />
            <ComboBox x:Name="FieldBox" Width="150" Margin="0,0,8,6" SelectionChanged="Field_SelectionChanged" />
            <CheckBox x:Name="FlaggedBox" Content="Flagged only" Margin="0,0,12,6" Click="Filter_Click" />
            <CheckBox x:Name="DeletedBox" Content="Show deleted" Margin="0,0,12,6" Click="Filter_Click" />
            <ComboBox x:Name="LocationBox" Width="120" Margin="0,0,8,6" DisplayMemberPath="Code" SelectionChanged="Location_SelectionChanged" ToolTip="Location" />
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <Button Content="New item" Style="{StaticResource AccentButton}" infra:Look.Shortcut="Ctrl+N" Click="New_Click" />
            <Button Content="Edit" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+O" ToolTip="Or press Enter on the list" Click="Edit_Click" />
            <Button Content="Print labels…" Style="{StaticResource DarkButton}" infra:Look.Icon="&#xE8A1;" infra:Look.Shortcut="Ctrl+P"
                    ToolTip="Barcode labels for the chosen items (all shown items when none is chosen)" Click="Labels_Click" />
            <Button Content="Duplicate" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+D" Click="Duplicate_Click" />
            <Button Content="Delete" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Del" Click="Delete_Click" />
            <Button Content="Undelete" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+U" Click="Restore_Click" />
            <Button Content="Adjust stock" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+J" Click="Adjust_Click" />
            <Button Content="Flag / unflag" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+G" Click="Flag_Click" />
            <Button Content="Clear flags" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+Shift+G" Click="ClearFlags_Click" />
            <Button Content="Change prices…" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+R" Click="ChangePrices_Click" />
            <Button Content="Copy to location…" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+M" Click="Copy_Click" />
            <Button Content="Export CSV" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+E" Click="Export_Click" />
            <Button Content="Import CSV" Style="{StaticResource ToolButton}" infra:Look.Shortcut="Ctrl+I" Click="Import_Click" />
        </WrapPanel>
        <DataGrid x:Name="ItemsGrid" Style="{StaticResource Grid}" MouseDoubleClick="Edit_Click" PreviewKeyDown="Grid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Flag" Binding="{Binding IsFlagged}" Width="56" />
                <DataGridTextColumn Header="Stock code" Binding="{Binding Plu}" Width="125" />
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="150" FontFamily="Consolas" />
                <DataGridTextColumn Header="Description" Binding="{Binding Name}" Width="*" MinWidth="220" />
                <DataGridTextColumn Header="Weight" Binding="{Binding WeightText}" Width="85" />
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130" />
                <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="140" />
                <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="95" />
                <DataGridTextColumn Header="On hand" Binding="{Binding OnHand, StringFormat=0.###}" Width="100" ElementStyle="{StaticResource Right}" />
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="65" ElementStyle="{StaticResource Right}" />
                <DataGridTextColumn Header="On order" Binding="{Binding OnOrder, StringFormat=0.###}" Width="88" ElementStyle="{StaticResource Right}" />
                <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="105" ElementStyle="{StaticResource Right}" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price1, StringFormat=N2}" Width="105" ElementStyle="{StaticResource Right}" />
                <DataGridCheckBoxColumn Header="Deleted" Binding="{Binding IsDeleted}" Width="88" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
