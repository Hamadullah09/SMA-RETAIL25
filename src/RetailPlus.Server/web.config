<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS on myASP.NET (pos.sma-techno.net): the server, its API and the web back office (in .\web) as one site.
  Out of process: the shared application pool allows one in-process .NET app per account. inheritInChildApplications="false"
  keeps this handler out of any application below the site root (Retail25's API at /backend, while it is still there).

  The database and the first administrator are set in the control panel (application pool › Environment Variables),
  never here: the deploy overwrites this file and the repository is public.
    ConnectionStrings__RetailPlus = Server=sqlNNNN.site4now.net;Database=…;User ID=…;Password=…;Encrypt=True;TrustServerCertificate=True
  The server keeps its keys and received packages in .\App_Data, which the deploy leaves alone. To see why the site
  does not start, set stdoutLogEnabled="true" for a moment (logs in .\logs).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\RetailPlus.Server.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Sync packages from the tills can be large (Server:MaxPackageMegabytes, 512 MB). -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="536870912" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <!-- The host's own files (domain checks, SSL certificate renewal) are served by IIS as they are, not by the server.
       The deploy leaves this folder alone. -->
  <location path=".well-known">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
      </handlers>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
