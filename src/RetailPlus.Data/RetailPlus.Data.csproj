<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RetailPlus.Core\RetailPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both engines: SQLite on the tills, SQL Server on the server. Their migrations live in RetailPlus.Data.Sqlite and RetailPlus.Data.SqlServer. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pinned above the version Microsoft.Data.SqlClient brings in (9.0.11: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Argon2id, to check staff PINs carried over from Retail25, which hashed them with this same library (MIT licence). -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
